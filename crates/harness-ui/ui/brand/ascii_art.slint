    pure public function think-index(id: string) -> int {
        return id == "bars" ? 1 : id == "pulse" ? 2 : id == "quads" ? 3 : id == "charge" ? 4 : id == "moon" ? 5 : id == "cipher" ? 6 : id == "chevrons" ? 7 : id == "bunny" ? 8 : 0;
