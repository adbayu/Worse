// Diff viewer (spec phase-8-ui.md §10): unified and side-by-side, old/new line numbers, hunk separators.
// Data: PanelDiff (filled by src/panels). Colours: Theme.diff-* (ZCode diff renderer tokens).
import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, IconButton, Segmented, Divider } from "../components/controls.slint";
import { PanelDiff, DiffRow, DiffPair } from "globals.slint";
import { PanelBar, PanelNotice } from "common.slint";

global DiffMetrics {
    out property <length> row-height: 20px;
    out property <length> gutter: 40px;
}

component LineNo inherits Text {
    width: DiffMetrics.gutter;
    font-family: Theme.mono-font;
    font-size: Theme.code-size;
    color: Theme.foreground-subtlest;
    horizontal-alignment: right;
    vertical-alignment: center;
}

component CodeText inherits Text {
    font-family: Theme.mono-font;
    font-size: Theme.code-size;
    color: Theme.foreground;
    vertical-alignment: center;
    overflow: clip;
}

component HunkHeader inherits Rectangle {
    in property <string> text;
    height: DiffMetrics.row-height;
    background: Theme.accent-soft;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    CodeText {
        x: Theme.space-2;
        width: parent.width - Theme.space-4;
        text: root.text;
        color: Theme.accent-fg;
        overflow: elide;
    }
}

component UnifiedRow inherits Rectangle {
    in property <DiffRow> item;
    height: DiffMetrics.row-height;
    background: item.kind == 1 ? Theme.diff-added-surface : item.kind == 2 ? Theme.diff-removed-surface : transparent;
    accessible-role: list-item;
    accessible-label: (item.kind == 1 ? "+" : item.kind == 2 ? "-" : " ") + " " + item.old-no + " " + item.new-no + " " + item.text;
    if item.kind == 3: HunkHeader {
        width: parent.width;
        text: item.text;
    }
    if item.kind != 3: HorizontalLayout {
        LineNo {
            text: item.old-no;
        }
        LineNo {
            text: item.new-no;
        }
        Text {
            width: 20px;
            text: item.kind == 1 ? "+" : item.kind == 2 ? "-" : "";
            font-family: Theme.mono-font;
            font-size: Theme.code-size;
            color: item.kind == 1 ? Theme.diff-added : Theme.diff-removed;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        CodeText {
            text: item.text;
            color: item.kind == 4 ? Theme.foreground-subtle : Theme.foreground;
            font-italic: item.kind == 4;
        }
    }
}

component SideCell inherits Rectangle {
    in property <int> kind;
    in property <string> no;
    in property <string> text;
    background: kind == 1 ? Theme.diff-added-surface : kind == 2 ? Theme.diff-removed-surface : kind == -1 ? Theme.surface : transparent;
    HorizontalLayout {
        LineNo {
            text: root.no;
        }
        Text {
            width: 16px;
            text: root.kind == 1 ? "+" : root.kind == 2 ? "-" : "";
            font-family: Theme.mono-font;
            font-size: Theme.code-size;
            color: root.kind == 1 ? Theme.diff-added : Theme.diff-removed;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        CodeText {
            text: root.text;
        }
    }
}

component SideRow inherits Rectangle {
    in property <DiffPair> pair;
    height: DiffMetrics.row-height;
    accessible-role: list-item;
    accessible-label: pair.hunk ? pair.header : (pair.left-no + " " + pair.left-text + " | " + pair.right-no + " " + pair.right-text);
    if pair.hunk: HunkHeader {
        width: parent.width;
        text: pair.header;
    }
    if !pair.hunk: HorizontalLayout {
        SideCell {
            width: (parent.width - 1px) / 2;
            kind: pair.left-kind;
            no: pair.left-no;
            text: pair.left-text;
        }
        Rectangle {
            width: 1px;
            background: Theme.border;
        }
        SideCell {
            kind: pair.right-kind;
            no: pair.right-no;
            text: pair.right-text;
        }
    }
}

component FileRowView inherits Rectangle {
    in property <string> path;
    in property <string> status;
    in property <int> added;
    in property <int> removed;
    in property <int> vulns;
    in property <bool> current;
    callback clicked();
    height: 28px;
    border-radius: Theme.radius-md;
    background: root.current ? Theme.raised : (ta.has-hover ? Theme.hover : transparent);
    accessible-role: list-item;
    accessible-label: root.status + " " + root.path;
    accessible-action-default => {
        root.clicked();
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;
        Text {
            width: 12px;
            text: root.status;
            font-size: Theme.ui-sm;
            font-weight: Theme.weight-semibold;
            color: root.status == "A" ? Theme.git-added : root.status == "D" ? Theme.git-deleted : root.status == "R" ? Theme.git-renamed : Theme.git-modified;
            vertical-alignment: center;
        }
        Text {
            text: root.path;
            font-size: 12px;
            color: root.current ? Theme.foreground : Theme.foreground-subtle;
            overflow: elide;
            vertical-alignment: center;
        }
        Rectangle {
            visible: root.vulns > 0;
            height: 17px;
            width: 26px;
            horizontal-stretch: 0;
            border-radius: Theme.radius-full;
            background: Theme.destructive.with-alpha(0.16);
            Text {
                text: root.vulns > 99 ? "99+" : "" + root.vulns;
                font-size: Theme.ui-xs;
                font-weight: Theme.weight-medium;
                color: Theme.destructive;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            horizontal-stretch: 0;
            text: "+" + root.added;
            font-size: 11px;
            color: Theme.success-surface-foreground;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 0;
            text: "−" + root.removed;
            font-size: 11px;
            color: Theme.destructive-surface-foreground;
            vertical-alignment: center;
        }
    }
}

export component DiffPanel inherits Rectangle {
    VerticalLayout {
        PanelBar {
            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-2;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: Theme.space-2;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.file-diff;
                        tint: Theme.icon-subtle;
                        size: Theme.icon-sm;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: PanelDiff.title == "" ? @tr("No diff selected") : PanelDiff.title;
                        font-size: Theme.ui-sm;
                        font-weight: Theme.weight-medium;
                        color: Theme.foreground;
                        overflow: elide;
                    }
                    if PanelDiff.subtitle != "": Text {
                        text: PanelDiff.subtitle;
                        font-size: Theme.ui-xs;
                        color: Theme.foreground-subtle;
                        overflow: elide;
                    }
                }
                if PanelDiff.source != "": HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: Theme.space-1;
                    Text {
                        text: "+" + PanelDiff.added;
                        font-size: Theme.ui-sm;
                        color: Theme.diff-added;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "−" + PanelDiff.removed;
                        font-size: Theme.ui-sm;
                        color: Theme.diff-removed;
                        vertical-alignment: center;
                    }
                }
                IconButton {
                    icon: Icons.git-branch;
                    label: @tr("Turn changes");
                    size: Theme.control-sm;
                    icon-size: Theme.icon-sm;
                    active: PanelDiff.source == "turn";
                    clicked => {
                        PanelDiff.show-turn();
                    }
                }
                IconButton {
                    icon: Icons.refresh-cw;
                    label: @tr("Refresh diff");
                    size: Theme.control-sm;
                    icon-size: Theme.icon-sm;
                    enabled: PanelDiff.source != "";
                    clicked => {
                        PanelDiff.refresh();
                    }
                }
            }
        }
        HorizontalLayout {
            padding: Theme.space-2;
            alignment: start;
            Segmented {
                height: Theme.control-lg;
                options: [{ id: "unified", label: @tr("Unified") }, { id: "split", label: @tr("Side by side") }];
                current: PanelDiff.side-by-side ? "split" : "unified";
                select(id) => {
                    PanelDiff.side-by-side = id == "split";
                }
            }
        }
        if PanelDiff.files.length > 1: Rectangle {
            height: min(PanelDiff.files.length * 26px, 130px) + Theme.space-2;
            ListView {
                x: Theme.space-1;
                width: parent.width - Theme.space-2;
                for f[i] in PanelDiff.files: FileRowView {
                    path: f.path;
                    status: f.status;
                    added: f.added;
                    removed: f.removed;
                    vulns: f.vulns;
                    current: i == PanelDiff.current-file;
                    clicked => {
                        PanelDiff.select-file(i);
                    }
                }
            }
        }
        if PanelDiff.files.length > 1: Divider { }
        Rectangle {
            vertical-stretch: 1;
            if PanelDiff.notice != "" || PanelDiff.loading: PanelNotice {
                width: parent.width;
                height: parent.height;
                text: PanelDiff.loading ? @tr("Loading…") : PanelDiff.notice;
            }
            if PanelDiff.notice == "" && !PanelDiff.loading && !PanelDiff.side-by-side: ListView {
                width: parent.width;
                height: parent.height;
                for r in PanelDiff.rows: UnifiedRow {
                    item: r;
                }
            }
            if PanelDiff.notice == "" && !PanelDiff.loading && PanelDiff.side-by-side: ListView {
                width: parent.width;
                height: parent.height;
                for p in PanelDiff.pairs: SideRow {
                    pair: p;
                }
            }
        }
    }
}
