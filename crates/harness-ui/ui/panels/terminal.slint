// Terminal panel (spec phase-8-ui.md §10): renders the emulator grid computed by src/panels (alacritty_terminal)
// and forwards keys / size. The PTY lives in harness-workspace; this view owns nothing but cell metrics.
import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, IconButton, Tag } from "../components/controls.slint";
import { PanelTerminal, TermLine, TermRun } from "globals.slint";
import { PanelBar } from "common.slint";

global TermColors {
    public pure function fg(code: int, rgb: color) -> color {
        return code == -1 ? Theme.terminal-fg : code == -2 ? Theme.terminal-bg : code == -3 ? rgb : Theme.terminal-ansi[code];
    }
    public pure function bg(code: int, rgb: color) -> color {
        return code == -1 ? transparent : code == -2 ? Theme.terminal-fg : code == -3 ? rgb : Theme.terminal-ansi[code];
    }
}

component TermRow inherits Rectangle {
    in property <TermLine> line;
    in property <length> cell-width;
    accessible-role: list-item;
    accessible-label: line.text;
    for run in line.runs: Rectangle {
        x: run.col * root.cell-width;
        width: run.cells * root.cell-width;
        height: root.height;
        background: TermColors.bg(run.bg, run.bg-rgb);
        Text {
            x: 0;
            width: parent.width + root.cell-width;
            text: run.text;
            font-family: Theme.mono-font;
            font-size: Theme.terminal-size;
            font-weight: run.bold ? Theme.weight-semibold : Theme.weight-normal;
            font-italic: run.italic;
            color: TermColors.fg(run.fg, run.fg-rgb);
            vertical-alignment: center;
            overflow: clip;
            wrap: no-wrap;
        }
        if run.underline: Rectangle {
            y: parent.height - 2px;
            height: 1px;
            background: TermColors.fg(run.fg, run.fg-rgb);
        }
    }
}

export component TerminalPanel inherits Rectangle {
    // Cell metrics from the mono font (10 glyphs measured to average out rounding).
    measure := Text {
        visible: false;
        text: "MMMMMMMMMM";
        font-family: Theme.mono-font;
        font-size: Theme.terminal-size;
    }
    property <length> cell-width: max(1px, measure.preferred-width / 10);
    property <length> line-height: max(1px, ceil(measure.preferred-height / 1px) * 1px);
    property <int> cols: max(2, floor((screen.width - 2 * Theme.space-2) / root.cell-width));
    property <int> rows: max(2, floor((screen.height - 2 * Theme.space-1) / root.line-height));
    changed cols => {
        PanelTerminal.resized(root.cols, root.rows);
    }
    changed rows => {
        PanelTerminal.resized(root.cols, root.rows);
    }
    init => {
        PanelTerminal.resized(root.cols, root.rows);
        keys.focus();
    }
    VerticalLayout {
        PanelBar {
            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-2;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: Theme.space-2;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.terminal;
                        tint: Theme.icon-subtle;
                        size: Theme.icon-sm;
                    }
                }
                Text {
                    text: PanelTerminal.title == "" ? @tr("Terminal") : PanelTerminal.title;
                    font-size: Theme.ui-sm;
                    font-weight: Theme.weight-medium;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if PanelTerminal.exited: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Tag {
                        text: @tr("Exited ({})", PanelTerminal.exit-code);
                        tone: PanelTerminal.exit-code == 0 ? "neutral" : "warning";
                        accessible-role: AccessibleRole.text;
                        accessible-label: self.text;
                    }
                }
                IconButton {
                    icon: Icons.refresh-cw;
                    label: @tr("Restart terminal");
                    size: Theme.control-sm;
                    icon-size: Theme.icon-sm;
                    clicked => {
                        PanelTerminal.restart();
                        keys.focus();
                    }
                }
                IconButton {
                    icon: Icons.x;
                    label: @tr("Kill terminal");
                    size: Theme.control-sm;
                    icon-size: Theme.icon-sm;
                    enabled: PanelTerminal.running;
                    clicked => {
                        PanelTerminal.close();
                    }
                }
            }
        }
        screen := Rectangle {
            vertical-stretch: 1;
            background: Theme.terminal-bg;
            clip: true;
            accessible-role: list;
            accessible-label: @tr("Terminal output");
            keys := FocusScope {
                accessible-role: text-input;
                accessible-label: @tr("Terminal input");
                key-pressed(event) => {
                    PanelTerminal.key(event.text, event.modifiers.control, event.modifiers.alt);
                    accept
                }
            }
            TouchArea {
                mouse-cursor: text;
                clicked => {
                    keys.focus();
                }
                scroll-event(event) => {
                    PanelTerminal.scroll(event.delta-y > 0 ? 3 : -3);
                    accept
                }
            }
            for line[i] in PanelTerminal.lines: TermRow {
                x: Theme.space-2;
                y: Theme.space-1 + i * root.line-height;
                width: root.cols * root.cell-width;
                height: root.line-height;
                line: line;
                cell-width: root.cell-width;
            }
            if PanelTerminal.cursor-visible: Rectangle {
                x: Theme.space-2 + PanelTerminal.cursor-col * root.cell-width;
                y: Theme.space-1 + PanelTerminal.cursor-row * root.line-height;
                width: root.cell-width;
                height: root.line-height;
                background: keys.has-focus ? Theme.terminal-cursor : transparent;
                border-width: 1px;
                border-color: Theme.terminal-cursor;
                opacity: keys.has-focus ? 0.55 : 0.8;
            }
            if PanelTerminal.error != "": Text {
                x: Theme.space-2;
                y: parent.height - self.height - Theme.space-2;
                width: parent.width - 2 * Theme.space-2;
                text: PanelTerminal.error;
                wrap: word-wrap;
                font-size: Theme.ui-xs;
                color: Theme.destructive;
            }
        }
    }
}
