// Git panel (ZCode GitPane mapping, spec phase-8-ui.md §10): branch, commit box, staged / unstaged changes.
// Data: PanelGit (filled by src/panels; the repository is the owner, the panel re-reads after every action).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, IconButton, Button, SectionLabel } from "../components/controls.slint";
import { PanelGit, PanelNav, GitRow } from "globals.slint";
import { PanelBar, PanelNotice } from "common.slint";
import { GitUi, ResultLine } from "gitops.slint";

component ChangeRow inherits Rectangle {
    in property <GitRow> item;
    height: 28px;
    border-radius: Theme.radius-md;
    background: ta.has-hover ? Theme.raised : transparent;
    accessible-role: list-item;
    accessible-label: item.code + " " + item.path;
    accessible-action-default => {
        PanelGit.open-diff(item.path, item.staged);
        PanelNav.open-tab("diff");
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PanelGit.open-diff(item.path, item.staged);
            PanelNav.open-tab("diff");
        }
    }
    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-1;
        spacing: Theme.space-1-5;
        Text {
            text: item.name;
            font-size: Theme.ui-sm;
            color: item.kind == "deleted" ? Theme.foreground-subtle : Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 0;
            overflow: elide;
        }
        Text {
            text: item.dir;
            font-size: Theme.ui-xs;
            color: Theme.foreground-subtlest;
            vertical-alignment: center;
            overflow: elide;
        }
        if ta.has-hover || action.has-focus: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            IconButton {
                icon: item.staged ? Icons.x : Icons.plus;
                label: item.staged ? @tr("Unstage {}", item.path) : @tr("Stage {}", item.path);
                size: Theme.control-xs;
                icon-size: Theme.icon-xs;
                clicked => {
                    if item.staged {
                        PanelGit.unstage(item.path);
                    } else {
                        PanelGit.stage(item.path);
                    }
                }
            }
        }
        // Keyboard / automation path to the same action while the row is not hovered.
        action := FocusScope {
            width: 0px;
            accessible-role: button;
            accessible-label: item.staged ? @tr("Unstage {}", item.path) : @tr("Stage {}", item.path);
            accessible-action-default => {
                if item.staged {
                    PanelGit.unstage(item.path);
                } else {
                    PanelGit.stage(item.path);
                }
            }
        }
        Text {
            width: 14px;
            text: item.code;
            font-size: Theme.ui-sm;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: item.kind == "added" || item.kind == "untracked" ? Theme.git-added : item.kind == "deleted" ? Theme.git-deleted : item.kind == "renamed" ? Theme.git-renamed : item.kind == "conflicted" ? Theme.destructive : Theme.git-modified;
        }
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <int> count;
    in property <string> action-label;
    in property <image> action-icon;
    callback action();
    height: 28px;
    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-1;
        spacing: Theme.space-1;
        SectionLabel {
            text: root.title + " (" + root.count + ")";
        }
        if root.count > 0: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            IconButton {
                icon: root.action-icon;
                label: root.action-label;
                size: Theme.control-xs;
                icon-size: Theme.icon-xs;
                clicked => {
                    root.action();
                }
            }
        }
    }
}

export component GitPanel inherits Rectangle {
    init => {
        PanelGit.refresh();
    }
    VerticalLayout {
        PanelBar {
            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-2;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: Theme.space-2;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.git-branch;
                        tint: Theme.icon-subtle;
                        size: Theme.icon-sm;
                    }
                }
                Text {
                    text: PanelGit.branch == "" ? (PanelGit.is-repo ? @tr("(no branch)") : @tr("No repository")) : PanelGit.branch;
                    font-size: Theme.ui-sm;
                    font-weight: Theme.weight-medium;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: AccessibleRole.text;
                    accessible-label: @tr("Branch {}", self.text);
                }
                // Branch switcher (GIT-009): opens the branch dialog (Rust loads the list).
                if PanelGit.is-repo: IconButton {
                    icon: Icons.chevron-down;
                    label: @tr("Switch branch");
                    size: Theme.control-sm;
                    icon-size: Theme.icon-sm;
                    clicked => {
                        GitUi.open("branches");
                    }
                }
                Text {
                    horizontal-stretch: 0;
                    text: PanelGit.sync;
                    font-size: Theme.ui-xs;
                    color: Theme.foreground-subtle;
                    vertical-alignment: center;
                }
                if PanelGit.is-repo: IconButton {
                    icon: Icons.arrow-up;
                    label: @tr("Push");
                    size: Theme.control-sm;
                    icon-size: Theme.icon-sm;
                    clicked => {
                        GitUi.open("push");
                    }
                }
                if PanelGit.is-repo: IconButton {
                    icon: Icons.git-fork;
                    label: @tr("Commit graph");
                    size: Theme.control-sm;
                    icon-size: Theme.icon-sm;
                    clicked => {
                        GitUi.open("graph");
                    }
                }
                IconButton {
                    icon: Icons.refresh-cw;
                    label: @tr("Refresh git status");
                    size: Theme.control-sm;
                    icon-size: Theme.icon-sm;
                    clicked => {
                        PanelGit.refresh();
                    }
                }
            }
        }
        if !PanelGit.is-repo: PanelNotice {
            vertical-stretch: 1;
            text: @tr("This workspace is not a git repository.");
        }
        if PanelGit.is-repo: VerticalLayout {
            vertical-stretch: 1;
            padding: Theme.space-2;
            spacing: Theme.space-2;
            // Commit box (ZCode GitPane: message input + primary commit button).
            Rectangle {
                height: 64px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: message.has-focus ? Theme.accent-line : Theme.border;
                background: Theme.surface;
                message := TextInput {
                    x: Theme.space-2;
                    y: Theme.space-1-5;
                    width: parent.width - 2 * Theme.space-2;
                    height: parent.height - 2 * Theme.space-1-5;
                    text <=> PanelGit.message;
                    font-size: Theme.ui-sm;
                    color: Theme.foreground;
                    wrap: word-wrap;
                    single-line: false;
                    accessible-role: text-input;
                    accessible-label: @tr("Commit message");
                }
                if PanelGit.message == "": Text {
                    x: Theme.space-2;
                    y: Theme.space-1-5;
                    text: @tr("Commit message");
                    font-size: Theme.ui-sm;
                    color: Theme.foreground-subtlest;
                }
            }
            HorizontalLayout {
                spacing: Theme.space-1;
                Button {
                    horizontal-stretch: 1;
                    text: PanelGit.staged.length > 0 ? @tr("Commit {} file(s)", PanelGit.staged.length) : @tr("Commit");
                    label: @tr("Commit");
                    variant: "primary";
                    size: "sm";
                    icon: Icons.check;
                    has-icon: true;
                    enabled: PanelGit.staged.length > 0 && PanelGit.message != "" && !PanelGit.loading;
                    clicked => {
                        PanelGit.commit();
                    }
                }
                // Commit dialog (GIT-007): include unstaged changes, commit & push.
                Button {
                    size: "sm";
                    icon: Icons.chevron-down;
                    has-icon: true;
                    label: @tr("More commit options");
                    enabled: PanelGit.staged.length + PanelGit.unstaged.length > 0 && !PanelGit.loading;
                    clicked => {
                        GitUi.open("commit");
                    }
                }
            }
            if PanelGit.error != "": Text {
                text: PanelGit.error;
                wrap: word-wrap;
                font-size: Theme.ui-xs;
                color: Theme.destructive;
                accessible-role: AccessibleRole.text;
                accessible-label: self.text;
            }
            // Outcome of the last branch switch / commit dialog / push (src/gitui.rs).
            if GitUi.result-kind != "": ResultLine { }
            if PanelGit.notice != "" && PanelGit.error == "": Text {
                text: PanelGit.notice;
                wrap: word-wrap;
                font-size: Theme.ui-xs;
                color: Theme.success;
                accessible-role: AccessibleRole.text;
                accessible-label: self.text;
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    SectionHeader {
                        title: @tr("Staged changes");
                        count: PanelGit.staged.length;
                        action-label: @tr("Unstage all");
                        action-icon: Icons.x;
                        action => {
                            PanelGit.unstage-all();
                        }
                    }
                    for r in PanelGit.staged: ChangeRow {
                        item: r;
                    }
                    SectionHeader {
                        title: @tr("Changes");
                        count: PanelGit.unstaged.length;
                        action-label: @tr("Stage all");
                        action-icon: Icons.plus;
                        action => {
                            PanelGit.stage-all();
                        }
                    }
                    for r in PanelGit.unstaged: ChangeRow {
                        item: r;
                    }
                    if PanelGit.loaded && PanelGit.staged.length == 0 && PanelGit.unstaged.length == 0: Text {
                        height: 40px;
                        text: @tr("No changes");
                        font-size: Theme.ui-sm;
                        color: Theme.foreground-subtle;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                }
            }
        }
    }
}
