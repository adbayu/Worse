import { Palette } from "std-widgets.slint";

// Design tokens. Monochrome first: near-black (or paper-white) surfaces, white (or ink) primary actions, grey
// hairlines, and one small accent (the bunny's hi-vis harness). Glass panels get a light rim and an inner glow.
export global Theme {
    in-out property <int> pref: 0;
    out property <bool> dark: pref == 2 || (pref == 0 && Palette.color-scheme == ColorScheme.dark);
    in-out property <bool> reduce-motion: false;

    // ---- surfaces ------------------------------------------------------------------------------------
    out property <color> canvas: dark ? #08090a : #f3f2ee;
    // Opaque cover for full-bleed pages (board, diff blocks).
    out property <color> background: dark ? #0b0c0d : #f8f7f4;
    out property <color> background-win-alt: canvas;
    out property <color> header: transparent;
    // Glass: translucent pane tint, and the opaque cut for anything that floats over text (there is no
    // backdrop blur here, so see-through would mean sharp text behind text), plus an inset well.
    out property <color> glass: dark ? #ffffff0a : #ffffff9e;
    out property <color> glass-strong: dark ? #131416 : #ffffff;
    out property <color> glass-deep: dark ? #050506 : #ecebe6;
    out property <color> glass-border: dark ? #ffffff1f : #ffffffd9;
    out property <color> glass-hairline: #00000000;
    out property <color> glass-highlight: dark ? #ffffff3d : #ffffff;
    out property <length> glass-shadow-blur: 44px;
    out property <length> glass-shadow-y: 18px;
    out property <color> glass-shadow: dark ? #00000080 : #2a26181f;
    out property <color> glass-panel: dark ? #ffffff08 : #ffffff8c;
    // Rim: bright where the light hits (top), a faint return at the bottom edge.
    out property <brush> glass-rim: dark ? @linear-gradient(180deg, #ffffff3d 0%, #ffffff14 28%, #ffffff0a 72%, #ffffff1f 100%) : @linear-gradient(180deg, #ffffff 0%, #ffffffd9 45%, #1a1b1d1f 100%);
    out property <brush> glass-sheen: dark ? @linear-gradient(180deg, #ffffff0d 0%, #ffffff03 30%, #ffffff00 55%) : @linear-gradient(180deg, #ffffffa6 0%, #ffffff33 30%, #ffffff00 55%);
    // Inner glow (Skia renderer only; other renderers skip inner shadows).
    out property <color> glass-inner: dark ? #ffffff1a : #ffffffe6;
    out property <length> glass-inner-blur: 16px;
    out property <color> panel: glass;
    out property <color> sidebar: glass;
    out property <color> well: dark ? #00000059 : #1a1b1d0a;

    out property <color> surface: dark ? #ffffff0a : #ffffffb8;
    out property <color> surface-hover: dark ? #ffffff17 : #ffffff;
    out property <color> raised: dark ? #ffffff12 : #ffffff;
    out property <color> user-bubble: dark ? #ffffff12 : #1a1b1d0f;
    out property <color> card: dark ? #ffffff08 : #ffffff99;
    out property <color> card-selected: dark ? #ffffff14 : #ffffff;
    out property <color> card-border: dark ? #ffffff14 : #1a1b1d14;
    out property <color> popover: glass-strong;
    out property <color> popover-header: dark ? #ffffff05 : #1a1b1d05;
    out property <color> popover-border: dark ? #ffffff24 : #1a1b1d1a;
    out property <color> menu: glass-strong;
    out property <color> menu-hover: dark ? #ffffff14 : #1a1b1d0d;
    out property <color> input: dark ? #ffffff0a : #ffffffcc;
    out property <color> input-focused: dark ? #ffffff10 : #ffffff;
    out property <color> input-border: dark ? #ffffff1a : #1a1b1d1f;
    out property <color> input-border-hover: dark ? #ffffff2e : #1a1b1d38;
    out property <color> input-border-focused: dark ? #ffffff66 : #1a1b1d80;
    out property <color> tab: transparent;
    out property <color> tab-active: dark ? #ffffff17 : #ffffff;
    out property <color> tab-border: card-border;
    out property <color> toast: glass-strong;
    out property <color> tooltip: dark ? #26272af5 : #1a1b1df0;
    out property <color> tooltip-foreground: dark ? #f4f4f5 : #f8f7f4;
    out property <color> tag: dark ? #ffffff12 : #1a1b1d0d;
    out property <color> scrim: dark ? #000000a6 : #1a1b1d47;
    out property <color> composer: dark ? #111214 : #ffffff;
    out property <color> composer-border: dark ? #ffffff24 : glass-border;

    out property <color> border: dark ? #ffffff14 : #1a1b1d14;
    out property <color> border-hover: dark ? #ffffff29 : #1a1b1d29;
    out property <color> section-line: dark ? #ffffff10 : #1a1b1d0f;
    out property <color> hover: dark ? #ffffff0d : #1a1b1d0a;
    out property <color> selected: dark ? #ffffff14 : #1a1b1d12;
    out property <color> resize-handle: dark ? #ffffff33 : #1a1b1d33;

    // ---- accent ------------------------------------------------------------------------------------------
    // Accent picked in Settings › Appearance. Dark shows it as picked; light uses a darker cut of the same hue
    // for text and lines (the picked colour is too pale on paper) and the picked colour itself for fills.
    in-out property <color> accent-pick: #c8f04a;
    out property <color> accent-fill: accent-pick;
    out property <color> on-accent: #10140a;
    out property <color> accent-fg: dark ? accent-pick : accent-pick.darker(0.9).mix(#1a1b1d, 0.55);
    out property <color> accent-soft: dark ? accent-pick.with-alpha(0.12) : accent-pick.with-alpha(0.34);
    out property <color> accent-line: dark ? accent-pick.with-alpha(0.42) : accent-fg.with-alpha(0.5);
    out property <color> glow: #00000000;
    out property <color> violet: dark ? #b3a7ee : #5d55a3;
    out property <color> violet-soft: dark ? #b3a7ee1f : #5d55a314;
    out property <color> ember: dark ? #ff9a52 : #b4530f;
    out property <color> ember-soft: dark ? #ff9a521f : #b4530f14;
    out property <color> sky: dark ? #7cc4ff : #0b68b0;
    out property <color> sky-soft: dark ? #7cc4ff1f : #0b68b014;
    out property <color> text-selection: dark ? #3b82f68c : #3b82f659;
    out property <color> accent: accent-soft;
    out property <color> brand: accent-fg;
    out property <color> find-highlight: dark ? #ffd24a33 : #fde68a;
    out property <color> find-highlight-active: dark ? #ffd24a : #f59e0b;

    // ---- text --------------------------------------------------------------------------------------------
    out property <color> foreground: dark ? #f4f4f5 : #1a1b1d;
    out property <color> foreground-subtle: dark ? #c5c6ca : #1a1b1dbd;
    out property <color> foreground-subtlest: dark ? #86888e : #1a1b1d85;
    out property <color> foreground-inverse: dark ? #08090a : #ffffff;
    out property <color> muted: dark ? #8f9197 : #5c5d5f;
    out property <color> caps-label: dark ? #6a6c72 : #7a7b7d;
    out property <color> icon: foreground;
    out property <color> icon-subtle: dark ? #9a9ca2 : #1a1b1da6;
    out property <color> icon-subtlest: dark ? #686a70 : #1a1b1d66;
    out property <color> link: sky;
    out property <color> icon-purple: violet;

    // ---- primary action: white on black, ink on paper -----------------------------------------------------
    out property <color> primary: dark ? #f4f4f5 : #1a1b1d;
    out property <color> primary-hover: dark ? #ffffff : #303134;
    out property <color> primary-foreground: dark ? #0b0c0d : #fbfaf7;
    out property <brush> primary-brush: primary;
    out property <brush> primary-brush-hover: primary-hover;
    out property <color> primary-shadow: dark ? #00000080 : #1a1b1d33;
    out property <color> secondary: surface;
    // Kept for callers of the old gradient: the "accent" button variant is now a flat accent fill.
    out property <brush> brand-gradient: accent-fill;

    // ---- status ------------------------------------------------------------------------------------------
    out property <color> success: dark ? #4bd992 : #17894a;
    out property <color> success-foreground: dark ? #04210f : #ffffff;
    out property <color> success-surface: dark ? #4bd9921f : #17894a1f;
    out property <color> success-surface-foreground: dark ? #4bd992 : #136f3d;
    out property <color> warning: dark ? #f5b14c : #c26a05;
    out property <color> warning-foreground: dark ? #2a1a00 : #ffffff;
    out property <color> warning-surface: dark ? #f5b14c1f : #c26a051f;
    out property <color> warning-surface-foreground: dark ? #f5b14c : #9c5504;
    out property <color> destructive: dark ? #f2555a : #d13b3b;
    out property <color> destructive-foreground: #ffffff;
    out property <color> destructive-surface: dark ? #f2555a1f : #d13b3b1a;
    out property <color> destructive-surface-foreground: dark ? #f2555a : #b02a2a;
    out property <color> info: dark ? #7cc4ff : #0b68b0;
    out property <color> info-surface: dark ? #7cc4ff1f : #0b68b01a;
    out property <color> progress-surface: dark ? #ffffff12 : #1a1b1d0d;
    out property <color> progress-surface-foreground: foreground;
    out property <color> confirm-surface: success-surface;
    out property <color> confirm-foreground: success-surface-foreground;
    out property <color> ask-surface: sky-soft;
    out property <color> ask-foreground: sky;
    out property <color> idle-task: violet;
    out property <color> idle-task-surface: violet-soft;

    out property <color> diff-added: success;
    out property <color> diff-added-foreground: success-foreground;
    out property <color> diff-removed: destructive;
    out property <color> diff-removed-foreground: dark ? #2a0505 : #ffffff;
    out property <color> diff-added-surface: dark ? #4bd9921a : #17894a17;
    out property <color> diff-removed-surface: dark ? #f2555a1a : #d13b3b14;
    out property <color> git-modified: warning;
    out property <color> git-added: success;
    out property <color> git-deleted: destructive;
    out property <color> git-renamed: sky;
    out property <color> git-untracked: success;
    out property <color> git-ignored: foreground-subtlest;
    out property <color> git-descendant: warning;

    out property <color> terminal-bg: dark ? #050506e6 : #ffffffcc;
    out property <color> terminal-fg: foreground;
    out property <color> terminal-cursor: accent-fg;
    out property <color> terminal-selection: dark ? #ffffff33 : #1a1b1d2e;
    out property <[color]> terminal-ansi: dark ? [#2b2d31, #f2555a, #4bd992, #f5b14c, #7cc4ff, #b3a7ee, #5fd8cb, #c5c6ca, #686a70, #ff8a8e, #86efac, #fcd34d, #a8d8ff, #cfc6ff, #99f6e4, #f4f4f5] : [#2b2d31, #d13b3b, #17894a, #c26a05, #0b68b0, #5d55a3, #0d8a80, #8f9197, #686a70, #e45858, #22a35a, #d98a1c, #2b83c9, #7a72c2, #14a79b, #1a1b1d];

    out property <color> markdown-inline-code: dark ? #ffffff14 : #1a1b1d0f;
    out property <color> file-node: sky-soft;
    out property <color> file-node-foreground: sky;
    out property <color> command-node: violet-soft;
    out property <color> command-node-foreground: violet;

    out property <color> syntax-keyword: dark ? #ff9a6b : #b4470f;
    out property <color> syntax-string: dark ? #b8d977 : #4c6b0b;
    out property <color> syntax-comment: dark ? #686a70 : #8a8b8d;
    out property <color> syntax-function: dark ? #8fcbff : #0b63b0;
    out property <color> syntax-type: dark ? #e9c46a : #8a5a00;
    out property <color> syntax-number: dark ? #c9b8ff : #6a3fb8;

    // ---- type --------------------------------------------------------------------------------------------
    in property <string> ui-font: "";
    in property <string> mono-font: "Consolas";
    // Bundled faces: wide display headings, the italic serif for taglines, and the mono the glyph art is set in.
    // AppWindow swaps the first two for the UI font when the interface language needs CJK glyphs.
    in-out property <string> display-font: "Syne";
    in-out property <string> serif-font: "Instrument Serif";
    out property <string> art-font: "JetBrains Mono";
    in-out property <length> ui-font-size: 14px;
    out property <length> ui-xl: ui-font-size + 4px;
    out property <length> ui-lg: ui-font-size + 2px;
    out property <length> ui-base: ui-font-size;
    out property <length> ui-caption: ui-font-size - 1px;
    out property <length> ui-sm: ui-font-size - 2px;
    out property <length> ui-xs: ui-font-size - 4px;
    out property <length> ui-settings-title: ui-font-size + 10px;
    in-out property <length> code-size: 12px;
    in-out property <length> terminal-size: 13px;
    out property <int> weight-normal: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <length> line-base: ui-font-size * 1.5;
    out property <length> line-sm: (ui-font-size - 2px) * 1.5;

    out property <length> space-0-5: 2px;
    out property <length> space-1: 4px;
    out property <length> space-1-5: 6px;
    out property <length> space-2: 8px;
    out property <length> space-2-5: 10px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;

    // Rounded, not pill-shaped: controls 8–10, cards 12–16, floating glass 18–24.
    out property <length> radius-full: 999px;
    out property <length> radius-3xl: 24px;
    out property <length> radius-2xl: 20px;
    out property <length> radius-xl: 16px;
    out property <length> radius-lg: 12px;
    out property <length> radius-md: 10px;
    out property <length> radius-sm: 7px;

    out property <length> control-xs: 22px;
    out property <length> control-sm: 26px;
    out property <length> control: 30px;
    out property <length> control-lg: 34px;
    out property <length> input-height: 38px;
    out property <length> icon-size: 18px;
    out property <length> icon-sm: 16px;
    out property <length> icon-xs: 14px;
    out property <length> frame-gap: 8px;
    out property <length> sidebar-width: 272px;
    // Wide enough for the five tabs, the title of a panel without a tab (Search) and the expand button.
    out property <length> side-pane-width: 364px;
    out property <length> topbar-height: 52px;
    out property <color> switch-on: accent-fill;
    out property <length> chat-max-width: 768px;

    out property <length> shadow-md-blur: 32px;
    out property <length> shadow-md-y: 12px;
    out property <color> shadow-md-color: dark ? #00000099 : #2a261829;
    out property <length> shadow-lg-blur: 64px;
    out property <length> shadow-lg-y: 24px;
    out property <color> shadow-lg-color: dark ? #000000b3 : #2a261838;
    out property <length> shadow-composer-blur: 40px;
    out property <color> shadow-composer-color: dark ? #00000099 : #2a261826;

    out property <duration> dur-press: reduce-motion ? 0ms : 120ms;
    out property <duration> dur-hover: reduce-motion ? 0ms : 150ms;
    out property <duration> dur-menu: reduce-motion ? 0ms : 180ms;
    out property <duration> dur-enter: reduce-motion ? 0ms : 220ms;
    out property <duration> dur-move: reduce-motion ? 0ms : 240ms;
    out property <duration> dur-dialog: reduce-motion ? 0ms : 240ms;
    out property <duration> dur-panel: reduce-motion ? 0ms : 280ms;

    // Agent identity colours (the only other chroma in the UI).
    out property <color> agent-claude: #e88a5c;
    out property <color> agent-codex: #3dd68c;
    out property <color> agent-deepseek: #4d6bfe;
    out property <color> agent-agy: #b07cff;
    out property <color> agent-gemini: #5bc0ff;
}
