import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, IconButton } from "../components/controls.slint";
import { ChatUi, SubagentRow, FleetGroup } from "../chat/globals.slint";
import { AgentTint } from "../panels/common.slint";
import { AgentLogo, AgentMark } from "../components/agent_logo.slint";
import { SettingsUi } from "../settings/globals.slint";
import { ArtClock } from "../components/ascii.slint";
import { LiveStatus, StatusPill, Avatar, Progress, LiveButton, Caps } from "./live_parts.slint";
import { SubNode, SessionGroup } from "./live_session.slint";

export component LiveHeader inherits Rectangle {
    in property <int> max-conc;
    in-out property <float> zoom;
    in-out property <length> pan-x;
    in-out property <length> pan-y;
    callback close();
    callback delegate();
    callback open-settings();
    // Open the PRD page (which agent works on which part of the PRD).
    callback open-prd();
    height: 56px;
    border-width: 0px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.chevron-left;
                label: @tr("Back to chat");
                clicked => {
                    root.close();
                }
            }
        }
        Text {
            text: @tr("Orchestra");
            font-family: Theme.display-font;
            font-size: 15px;
            font-weight: 700;
            color: Theme.foreground;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 1px;
                height: 16px;
                background: Theme.border-hover;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                width: rp.preferred-width + 26px;
                border-radius: 10px;
                background: Theme.success.with-alpha(0.12);
                Rectangle {
                    x: 9px;
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.success;
                }
                rp := Text {
                    x: 19px;
                    text: @tr("{0} / {1} running", ChatUi.fleet-running, root.max-conc);
                    font-size: 11px;
                    font-weight: Theme.weight-medium;
                    color: Theme.success;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: ChatUi.fleet-sessions == 0 ? @tr("No session running") : @tr("{0} sessions active", ChatUi.fleet-sessions);
            font-size: 12px;
            color: Theme.foreground-subtlest;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.settings;
                label: @tr("Orchestra settings");
                clicked => {
                    root.open-settings();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            LiveButton {
                text: "PRD";
                clicked => {
                    root.open-prd();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            LiveButton {
                text: @tr("Auto-layout");
                clicked => {
                    root.zoom = 1.0;
                    root.pan-x = 0px;
                    root.pan-y = 0px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            LiveButton {
                text: @tr("+  Delegate task");
                variant: "accent";
                clicked => {
                    root.delegate();
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.raised;
    }
}

export component LiveDetail inherits Rectangle {
    in property <SubagentRow> cur;
    in property <bool> has-sel;
    in-out property <bool> detail;
    callback close();
    width: 290px;
    background: Theme.well;
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.raised;
    }
    VerticalLayout {
        padding: 14px;
        padding-left: 15px;
        spacing: 12px;
        HorizontalLayout {
            Caps {
                text: @tr("SUBAGENT");
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            IconButton {
                icon: Icons.x;
                label: @tr("Close details");
                size: 22px;
                icon-size: 12px;
                clicked => {
                    root.detail = false;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Avatar {
                agent: root.cur.agent;
                size: 30px;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.cur.agent-name;
                    font-size: 13px;
                    font-weight: Theme.weight-semibold;
                    color: Theme.foreground;
                    overflow: elide;
                }
                Text {
                    text: root.cur.id;
                    font-size: 10px;
                    color: Theme.foreground-subtlest;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                StatusPill {
                    status: root.cur.status;
                }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                Caps {
                    text: @tr("AGENT");
                }
                Text {
                    text: root.cur.agent-name;
                    font-size: 12px;
                    color: Theme.foreground-subtle;
                    overflow: elide;
                }
            }
            VerticalLayout {
                spacing: 3px;
                Caps {
                    text: @tr("ELAPSED");
                    horizontal-alignment: right;
                }
                Text {
                    text: ChatUi.elapsed(root.cur.started-s, root.cur.finished-s);
                    font-size: 12px;
                    color: Theme.foreground-subtle;
                    horizontal-alignment: right;
                }
            }
        }
        VerticalLayout {
            spacing: 6px;
            Caps {
                text: @tr("TASK");
            }
            Text {
                text: root.cur.title;
                font-size: 12px;
                color: Theme.foreground;
                wrap: word-wrap;
            }
        }
        // Live log (design: mono box). The hub streams one activity line; the latest answer follows.
        Rectangle {
            border-radius: 8px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Caps {
                    text: @tr("LIVE ACTIVITY");
                }
                if root.cur.activity != "": Text {
                    text: root.cur.activity;
                    font-family: Theme.mono-font;
                    font-size: 11px;
                    color: Theme.foreground-subtle;
                    wrap: word-wrap;
                }
                if root.cur.preview != "": Text {
                    text: root.cur.preview;
                    font-family: Theme.mono-font;
                    font-size: 11px;
                    color: root.cur.status == 2 ? Theme.success : (root.cur.status == 3 ? Theme.destructive : Theme.muted);
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 150px;
                }
                if root.cur.activity == "" && root.cur.preview == "": Text {
                    text: root.cur.status == 0 ? @tr("thinking…") : LiveStatus.label(root.cur.status);
                    font-family: Theme.mono-font;
                    font-size: 11px;
                    color: Theme.foreground-subtlest;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            spacing: 8px;
            LiveButton {
                horizontal-stretch: 1;
                text: @tr("Message");
                clicked => {
                    ChatUi.subagent-action("open", root.cur.id);
                    root.close();
                }
            }
            LiveButton {
                horizontal-stretch: 1;
                text: @tr("Stop");
                variant: "danger";
                enabled: root.cur.status <= 1;
                clicked => {
                    ChatUi.subagent-action("stop", root.cur.id);
                }
            }
        }
    }
}
