// PRD page parts: header pill, phase column, feature header and task card.
import { Theme } from "../theme/tokens.slint";
import { LiveButton } from "./live_parts.slint";
import { PrdUi, PrdPhase, PrdNode } from "./prd_ui.slint";

export component PrdHeaderPill inherits VerticalLayout {
    in property <string> text;
    in property <color> tint;
    alignment: center;
    Rectangle {
        height: 22px;
        width: pt.preferred-width + 20px;
        border-radius: 11px;
        background: root.tint.with-alpha(0.12);
        pt := Text {
            text: root.text;
            font-size: Theme.ui-caption;
            font-weight: Theme.weight-medium;
            color: root.tint;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// Round initial of an agent name.
component AgentAvatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background: root.tint.with-alpha(0.18);
    Text {
        text: root.initial == "" ? "?" : root.initial;
        font-size: 9px;
        font-weight: Theme.weight-semibold;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StatusDot inherits Rectangle {
    in property <string> status;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: PrdUi.status-color(root.status);
}

// One sub-feature / task: status, title, ids, agent, target files and its Done when check.
component PrdCard inherits Rectangle {
    in property <PrdNode> node;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: root.node.live == 0 || root.node.status == "running" ? Theme.accent-line : Theme.border;
    VerticalLayout {
        padding: 10px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 7px;
            StatusDot {
                y: (parent.height - self.height) / 2;
                status: root.node.status;
            }
            Text {
                horizontal-stretch: 1;
                text: root.node.title;
                font-size: Theme.ui-sm;
                font-weight: Theme.weight-medium;
                color: Theme.foreground;
                wrap: word-wrap;
            }
            Text {
                text: root.node.status == "" ? "planned" : root.node.status;
                font-size: 10px;
                color: PrdUi.status-color(root.node.status);
                vertical-alignment: center;
            }
        }
        if root.node.task != "" || root.node.req != "": Text {
            text: root.node.task + (root.node.task != "" && root.node.req != "" ? " · " : "") + root.node.req + (root.node.depends != "" ? " · after " + root.node.depends : "");
            font-size: 10px;
            color: Theme.muted;
            wrap: word-wrap;
        }
        // The subagent on this task (Orchestra live data), else the agent prd.json names.
        if root.node.live >= 0: HorizontalLayout {
            spacing: 6px;
            AgentAvatar {
                initial: root.node.initial;
                tint: PrdUi.live-color(root.node.live);
            }
            Text {
                horizontal-stretch: 1;
                text: root.node.live-agent + " · " + PrdUi.live-text(root.node.live) + (root.node.live-activity != "" ? " · " + root.node.live-activity : "");
                font-size: 10px;
                color: PrdUi.live-color(root.node.live);
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.node.live < 0 && root.node.agent != "": HorizontalLayout {
            spacing: 6px;
            AgentAvatar {
                initial: root.node.initial;
                tint: Theme.muted;
            }
            Text {
                text: root.node.agent;
                font-size: 10px;
                color: Theme.foreground-subtle;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.node.files != "": Text {
            text: root.node.files;
            font-family: Theme.mono-font;
            font-size: 10px;
            color: Theme.foreground-subtle;
            wrap: word-wrap;
        }
        if root.node.done-when != "": Text {
            text: "Done when: " + root.node.done-when;
            font-size: 10px;
            color: Theme.muted;
            wrap: word-wrap;
        }
        if root.node.status != "done" && root.node.live != 0 && root.node.live != 1: HorizontalLayout {
            alignment: end;
            LiveButton {
                text: root.node.live >= 2 ? @tr("Run again") : @tr("Run");
                clicked => {
                    PrdUi.run-task(root.node.task != "" ? root.node.task : root.node.id);
                }
            }
        }
    }
}

// One phase: title, progress and Run button, then its features and task cards.
export component PrdColumn inherits Rectangle {
    in property <PrdPhase> phase;
    in property <int> index;
    border-radius: Theme.radius-md;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            StatusDot {
                y: (parent.height - self.height) / 2;
                status: root.phase.status;
            }
            Text {
                horizontal-stretch: 1;
                text: root.phase.title;
                font-size: Theme.ui-sm;
                font-weight: Theme.weight-semibold;
                color: Theme.foreground;
                wrap: word-wrap;
            }
            Text {
                text: root.phase.done + "/" + root.phase.total;
                font-size: Theme.ui-caption;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
        LiveButton {
            text: root.phase.total > 0 && root.phase.done == root.phase.total ? "Phase done" : "Run phase";
            variant: "accent";
            enabled: root.phase.total == 0 || root.phase.done < root.phase.total;
            clicked => {
                PrdUi.run-phase(root.phase.id);
            }
        }
        for n in PrdUi.nodes: VerticalLayout {
            if n.phase == root.index && n.kind == "feature": Text {
                text: n.title;
                font-size: 10px;
                font-weight: Theme.weight-semibold;
                letter-spacing: 0.6px;
                color: Theme.caps-label;
                wrap: word-wrap;
            }
            if n.phase == root.index && n.kind == "sub": PrdCard {
                node: n;
            }
        }
    }
}
