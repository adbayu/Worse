import { Theme } from "../../theme/tokens.slint";
import { AgentsUi, ProviderRow } from "../globals.slint";
import { AgentLogo } from "../../components/agent_logo.slint";
import { FallbackRow } from "./types.slint";
import { AgentsLook, Pill, DButton, Glyph, Tile } from "./parts.slint";

export component FallbackItem inherits VerticalLayout {
    in property <FallbackRow> a;
    in property <int> index;
    in property <int> count;
    callback move(int, int);
    if root.index > 0: Rectangle {
        height: 1px;
        background: AgentsLook.rule;
    }
    Rectangle {
        height: 40px;
        background: rta.has-hover ? Theme.hover : Theme.hover.with-alpha(0);
        rta := TouchArea { }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            Text {
                text: "⋮⋮";
                font-size: 11px;
                color: root.a.state == 0 ? Theme.icon-subtlest : AgentsLook.drag;
                vertical-alignment: center;
                accessible-role: none;
            }
            Text {
                text: root.index + 1;
                min-width: 7px;
                font-size: 10.5px;
                color: root.a.state == 0 ? Theme.muted : Theme.icon-subtlest;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Tile {
                    size: 22px;
                    font: 9.24px;
                    logo: AgentLogo.key(root.a.id);
                    dim: root.a.state != 0;
                    initial: AgentsLook.initial-of(root.a.id);
                    tone: root.a.state == 0 ? AgentsLook.color-of(root.a.id) : Theme.border-hover;
                    ink: root.a.state == 0 ? AgentsLook.ink-of(root.a.id) : #FFFFFF;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.a.name;
                    font-size: 12px;
                    color: root.a.state == 0 ? Theme.foreground : Theme.icon-subtlest;
                    overflow: elide;
                }
                Text {
                    text: AgentsLook.vendor-of(root.a.id);
                    font-size: 10px;
                    color: Theme.icon-subtlest;
                    overflow: elide;
                }
            }
            if rta.has-hover && root.index > 0: VerticalLayout {
                alignment: center;
                Glyph {
                    text: "▲";
                    size: 9px;
                    label: @tr("Move {0} up", root.a.name);
                    clicked => {
                        root.move(root.index, -1);
                    }
                }
            }
            if rta.has-hover && root.index < root.count - 1: VerticalLayout {
                alignment: center;
                Glyph {
                    text: "▼";
                    size: 9px;
                    label: @tr("Move {0} down", root.a.name);
                    clicked => {
                        root.move(root.index, 1);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Pill {
                    text: root.a.state == 0 ? @tr("Ready") : root.a.state == 1 ? @tr("Not installed") : root.a.state == 3 ? "Adapter missing" : @tr("Limit reached");
                    tone: root.a.state == 0 ? Theme.success : root.a.state == 1 ? Theme.icon-subtlest : Theme.warning;
                    size: 9px;
                    pad-v: 1px;
                    pad-h: 6px;
                }
            }
            VerticalLayout {
                alignment: center;
                Glyph {
                    text: "✕";
                    size: 10px;
                    label: @tr("Disable {0}", root.a.name);
                    clicked => {
                        AgentsUi.set-enabled(root.a.id, false);
                    }
                }
            }
        }
    }
}

export component ProviderCard inherits Rectangle {
    in property <ProviderRow> p;
    in-out property <string> menu;
    height: 50px;
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            Tile {
                size: 26px;
                font: 10.9px;
                logo: root.p.kind == "command-code" ? "commandcode" : AgentLogo.key(root.p.label);
                initial: AgentsLook.provider-initial(root.p.label);
                tone: AgentsLook.provider-color(root.p.label);
                ink: root.p.label.to-lowercase() == "openai" ? Theme.canvas : #FFFFFF;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.p.label;
                    font-size: 12.5px;
                    font-weight: Theme.weight-semibold;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: !root.p.has-key ? @tr("No API key") : !root.p.loaded ? @tr("Restart to activate") : "Custom";
                        tone: !root.p.has-key ? Theme.warning : !root.p.loaded ? Theme.icon-subtlest : Theme.agent-agy;
                        size: 9px;
                        pad-v: 1px;
                        pad-h: 6px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: root.p.kind == "command-code" ? "Command Code key" : "OpenAI-compatible";
                        size: 9px;
                        pad-v: 1px;
                        pad-h: 6px;
                    }
                }
            }
            Text {
                text: root.p.kind == "command-code" ? "Takes turns with the other Command Code keys (round robin)" : root.p.model;
                font-size: 10.5px;
                color: Theme.icon-subtlest;
                overflow: elide;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            Text {
                text: root.p.kind == "command-code" ? "command-code acp" : root.p.endpoint;
                font-size: 10px;
                color: Theme.icon-subtlest;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: !root.p.has-key ? "needs key" : !root.p.loaded ? "pending restart" : "OK";
                font-size: 10px;
                color: !root.p.has-key ? Theme.warning : Theme.muted;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.p.has-key ? "key ••••" : "no key";
            font-size: 10px;
            color: Theme.icon-subtlest;
            vertical-alignment: center;
        }
        if root.menu == root.p.id: VerticalLayout {
            alignment: center;
            DButton {
                text: @tr("Remove");
                h: 24px;
                pad: 9px;
                size: 11px;
                clicked => {
                    root.menu = "";
                    AgentsUi.remove-provider(root.p.id);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Glyph {
                text: "⋯";
                label: @tr("More for {0}", root.p.label);
                active: root.menu == root.p.id;
                clicked => {
                    root.menu = root.menu == root.p.id ? "" : root.p.id;
                }
            }
        }
    }
}
