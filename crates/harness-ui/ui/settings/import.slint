// Import page — design frame "S16 · Import" (FigCraft), 1:1: Source card (detected folders + Scan, scan summary
// with an amber "already imported" pill), "Detected sessions" table card (Select all toggle, checkbox / SESSION /
// PROJECT / TURNS / LAST ACTIVE / STATE columns, 42px zebra rows) and the import bar (Cancel + primary Import).
import { Theme } from "../theme/tokens.slint";
import { Icon, Icons } from "../components/controls.slint";
import { PageHeader, StatusLine, SetButton, Pill, Dot, CapsLabel, Switch, SegmentedControl, SearchField } from "parts.slint";
import { CheckBox, Rule, TableHead } from "./import_parts.slint";
export { CheckBox, Rule, TableHead }
import { ImportRow, ImportUi } from "./import_ui.slint";
export { ImportRow, ImportUi }

export component ImportPage inherits VerticalLayout {
    in property <bool> stacked;
    spacing: 20px;
    PageHeader {
        title: @tr("Import");
        description: @tr("Bring existing Claude Code, Codex and ZCode sessions into Harness. Transcripts are copied, originals untouched.");
    }
    // Source card.
    Rectangle {
        background: Theme.card;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card-border;
        VerticalLayout {
            padding: 1px;
            TableHead {
                title: @tr("Source");
                sub: @tr("Detected agent history folders");
            }
            Rule { }
            VerticalLayout {
                padding-top: 14px;
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 16px;
                spacing: 12px;
                // Path row (design: 34px input with a green dot, then Scan).
                HorizontalLayout {
                    spacing: 10px;
                    height: 34px;
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Dot {
                                    size: 6px;
                                    tint: ImportUi.count-all > 0 ? Theme.success : Theme.icon-subtlest;
                                }
                            }
                            Text {
                                text: "~/.claude/projects  ·  ~/.codex/sessions  ·  ZCode history";
                                font-size: 12px;
                                color: Theme.foreground-subtle;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        SetButton {
                            text: ImportUi.busy != "" ? @tr("Scanning…") : @tr("Scan");
                            enabled: ImportUi.busy == "";
                            clicked => {
                                ImportUi.refresh();
                            }
                        }
                    }
                }
                // Scan summary + source filter.
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: ImportUi.busy != "" ? ImportUi.busy : @tr("Found {0} sessions", ImportUi.count-all);
                        font-size: 11px;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    if ImportUi.imported-count > 0: VerticalLayout {
                        alignment: center;
                        Pill {
                            height: 16px;
                            text: @tr("{0} already imported", ImportUi.imported-count);
                            tint: Theme.warning;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    SegmentedControl {
                        label: @tr("Source");
                        options: [
                            { id: "all", label: @tr("All {0}", ImportUi.count-all) },
                            { id: "claude-code", label: @tr("Claude Code {0}", ImportUi.count-claude) },
                            { id: "codex", label: @tr("Codex {0}", ImportUi.count-codex) },
                            { id: "zcode", label: @tr("ZCode {0}", ImportUi.count-zcode) },
                        ];
                        current: ImportUi.filter;
                        select(id) => {
                            ImportUi.set-filter(id);
                        }
                    }
                }
                if ImportUi.busy == "" && ImportUi.status != "": StatusLine {
                    text: ImportUi.status;
                    error: ImportUi.status-error;
                }
            }
        }
    }
    // Detected sessions card.
    Rectangle {
        background: Theme.card;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card-border;
        clip: true;
        VerticalLayout {
            padding: 1px;
            TableHead {
                title: @tr("Detected sessions");
                sub: ImportUi.query != "" ? @tr("{0} matching · {1} selected", ImportUi.rows.length, ImportUi.selected) : @tr("{0} sessions · {1} selected", ImportUi.rows.length, ImportUi.selected);
                Text {
                    text: @tr("Select all");
                    font-size: 11px;
                    color: Theme.accent-fg;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        label: @tr("Select all");
                        checked: ImportUi.all-selected;
                        toggled(on) => {
                            ImportUi.select-all(on);
                        }
                    }
                }
            }
            Rule { }
            // Search by session name, session id or project folder.
            HorizontalLayout {
                padding-top: 12px;
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 4px;
                spacing: 8px;
                SearchField {
                    height: 34px;
                    text <=> ImportUi.query;
                    placeholder: @tr("Search sessions by name, ID or project…");
                    edited(text) => {
                        ImportUi.search(text);
                    }
                }
                if ImportUi.query != "": VerticalLayout {
                    alignment: center;
                    SetButton {
                        text: @tr("Clear");
                        clicked => {
                            ImportUi.query = "";
                            ImportUi.search("");
                        }
                    }
                }
            }
            VerticalLayout {
                padding-top: 4px;
                HorizontalLayout {
                    height: 30px;
                    padding-left: 16px;
                    padding-right: 16px;
                    Rectangle {
                        width: 28px;
                    }
                    CapsLabel {
                        text: @tr("SESSION");
                        min-width: root.stacked ? 0px : 300px;
                        max-width: root.stacked ? 100000px : 300px;
                        horizontal-stretch: root.stacked ? 1 : 0;
                    }
                    if !root.stacked: CapsLabel {
                        text: @tr("PROJECT");
                        width: 190px;
                    }
                    if !root.stacked: CapsLabel {
                        text: @tr("TURNS");
                        width: 100px;
                    }
                    if !root.stacked: CapsLabel {
                        text: @tr("LAST ACTIVE");
                        width: 160px;
                    }
                    if !root.stacked: Rectangle {
                        horizontal-stretch: 1;
                    }
                    CapsLabel {
                        text: @tr("STATE");
                        width: 66px;
                        horizontal-alignment: right;
                    }
                }
                Rule { }
            }
            VerticalLayout {
                padding-bottom: 8px;
                for r[i] in ImportUi.rows: Rectangle {
                    height: 42px;
                    background: rta.has-hover && !r.imported ? Theme.hover : (Math.mod(i, 2) == 0 ? Theme.surface : transparent);
                    animate background { duration: Theme.dur-hover; }
                    rta := TouchArea {
                        enabled: !r.imported;
                        clicked => {
                            ImportUi.toggle(r.key);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        HorizontalLayout {
                            width: 28px;
                            VerticalLayout {
                                alignment: center;
                                CheckBox {
                                    checked: r.selected;
                                    enabled: !r.imported;
                                    label: @tr("Select {0}", r.title);
                                    toggled => {
                                        ImportUi.toggle(r.key);
                                    }
                                }
                            }
                        }
                        Text {
                            min-width: root.stacked ? 0px : 300px;
                            max-width: root.stacked ? 100000px : 300px;
                            horizontal-stretch: root.stacked ? 1 : 0;
                            text: r.title;
                            font-size: 12px;
                            color: r.imported ? Theme.icon-subtlest : Theme.foreground-subtle;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if !root.stacked: Text {
                            width: 190px;
                            text: r.project;
                            font-size: 11px;
                            color: Theme.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if !root.stacked: Text {
                            width: 100px;
                            text: r.turns;
                            font-size: 11px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        if !root.stacked: Text {
                            width: 160px;
                            text: r.active;
                            font-size: 11px;
                            color: Theme.icon-subtlest;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if !root.stacked: Rectangle {
                            horizontal-stretch: 1;
                        }
                        HorizontalLayout {
                            width: 66px;
                            alignment: end;
                            VerticalLayout {
                                alignment: center;
                                Pill {
                                    height: 16px;
                                    text: r.imported ? @tr("imported") : @tr("new");
                                    tint: r.imported ? Theme.success : Theme.accent-fg;
                                }
                            }
                        }
                    }
                }
                if ImportUi.rows.length == 0: VerticalLayout {
                    padding: 32px;
                    spacing: 4px;
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            source: Icons.download;
                            size: 20px;
                            tint: Theme.icon-subtlest;
                        }
                    }
                    Text {
                        text: ImportUi.busy != "" ? @tr("Looking for sessions…") : ImportUi.query != "" ? @tr("No sessions match \"{0}\"", ImportUi.query) : @tr("No sessions found");
                        font-size: 13px;
                        color: Theme.foreground-subtle;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: @tr("Harness looks in ~/.claude, ~/.codex and the ZCode history folders.");
                        font-size: 12px;
                        color: Theme.icon-subtlest;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
    // Import bar (design: card, pad [10,16], "N sessions selected · M messages" 12 + sub 11, Cancel + primary).
    Rectangle {
        border-radius: 12px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.card-border;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("{0} sessions selected · {1} turns", ImportUi.selected, ImportUi.selected-turns);
                    font-size: 12px;
                    color: Theme.foreground;
                    overflow: elide;
                }
                Text {
                    text: @tr("Copied into ~/.harness — the agents' original history files are not modified.");
                    font-size: 11px;
                    color: Theme.icon-subtlest;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                SetButton {
                    text: @tr("Cancel");
                    enabled: ImportUi.selected > 0;
                    clicked => {
                        ImportUi.clear-selection();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                SetButton {
                    text: @tr("Import {0} sessions", ImportUi.selected);
                    variant: "primary";
                    enabled: ImportUi.selected > 0 && ImportUi.busy == "";
                    clicked => {
                        ImportUi.import-selected();
                    }
                }
            }
        }
    }
}
