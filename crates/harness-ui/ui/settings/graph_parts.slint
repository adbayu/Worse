import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icons, Icon } from "../components/controls.slint";
import { ArtClock } from "../components/ascii.slint";
import { GraphUi, GraphLabel, GraphHit } from "globals.slint";

// A round button of the control bar.
export component Knob inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> ink;
    in property <bool> on;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: ta.has-hover || root.on ? root.ink.with-alpha(0.14) : root.ink.with-alpha(0);
    animate background { duration: Theme.dur-hover; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    Icon {
        source: root.icon;
        size: 14px;
        tint: ta.has-hover || root.on ? root.ink : root.ink.with-alpha(0.62);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A glass pill with a few words on it.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    in property <color> glass;
    in property <color> rim;
    in property <bool> on;
    callback clicked;
    height: 26px;
    width: t.preferred-width + 22px;
    border-radius: 13px;
    background: root.on ? root.ink.with-alpha(0.16) : root.glass;
    border-width: 1px;
    border-color: ta.has-hover ? root.ink.with-alpha(0.3) : root.rim;
    animate border-color { duration: Theme.dur-hover; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    t := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 500;
        color: root.on || ta.has-hover ? root.ink : root.ink.with-alpha(0.78);
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One node in a list.
export component HitRow inherits Rectangle {
    in property <GraphHit> hit;
    in property <color> ink;
    in property <color> dot;
    callback clicked;
    height: 36px;
    border-radius: 7px;
    background: ta.has-hover ? root.ink.with-alpha(0.08) : root.ink.with-alpha(0);
    accessible-role: button;
    accessible-label: root.hit.title;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            width: 6px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.dot;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.hit.title;
                font-size: 11.5px;
                color: root.ink;
                overflow: elide;
            }
            Text {
                text: root.hit.note;
                font-size: 9.5px;
                color: root.ink.with-alpha(0.5);
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
