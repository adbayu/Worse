import { Theme } from "../theme/tokens.slint";
import { Icon, Icons } from "../components/controls.slint";
import { ProjectsUi, ArchiveUi } from "globals.slint";
import { PageHeader, SearchField, UnsupportedNotice, SetButton, Pill, Dot, CapsLabel } from "parts.slint";
import { Rule, EmptyBody, TableHead, ActionBar } from "./data_parts.slint";

export component ProjectsPage inherits VerticalLayout {
    in property <bool> stacked;
    callback request-remove(bool);
    callback add-folder();
    // Design project dots: orange, accent, blue, purple, green (cycled).
    property <[color]> dots: [Theme.ember, Theme.accent-fg, Theme.info, Theme.violet, Theme.success];
    spacing: 20px;
    PageHeader {
        title: @tr("Projects");
        description: @tr("Workspace folders Harness has opened. Each keeps its own sessions, memory and instructions.");
    }
    if !ProjectsUi.available: UnsupportedNotice {
        title: @tr("Project management needs the hub project API");
        reason: @tr("Harness lists the current workspace only until the hub exposes its project list.");
    }
    // Toolbar (design: "4 projects" 12 #8A909A + blue pill "142 sessions", "+ Add folder" primary right).
    HorizontalLayout {
        height: 34px;
        spacing: 8px;
        Text {
            text: @tr("{0} projects", ProjectsUi.rows.length);
            font-size: 12px;
            color: Theme.muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Pill {
                text: @tr("{0} sessions", ProjectsUi.total-sessions);
                tint: Theme.info;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            SetButton {
                text: @tr("+ Add folder");
                variant: "primary";
                clicked => {
                    root.add-folder();
                }
            }
        }
    }
    if ProjectsUi.undo-count > 0: ActionBar {
        text: @tr("{0} project(s) removed. Their sessions stay in Recent and search.", ProjectsUi.undo-count);
        SetButton {
            text: @tr("Undo");
            clicked => {
                ProjectsUi.undo-remove();
            }
        }
    }
    Rectangle {
        background: Theme.card;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card-border;
        clip: true;
        VerticalLayout {
            padding: 1px;
            TableHead {
                title: @tr("Workspace folders");
                sub: @tr("Ordered by last opened");
            }
            Rule { }
            // Table header (design "thead": 30px after 4px top pad; columns 200 / 250 / 100 / 150 / 40).
            VerticalLayout {
                padding-top: 4px;
                HorizontalLayout {
                    height: 30px;
                    padding-left: 16px;
                    padding-right: 16px;
                    CapsLabel {
                        text: @tr("PROJECT");
                        min-width: root.stacked ? 0px : 200px;
                        max-width: root.stacked ? 100000px : 200px;
                        horizontal-stretch: root.stacked ? 1 : 0;
                    }
                    if !root.stacked: CapsLabel {
                        text: @tr("PATH");
                        width: 250px;
                    }
                    if !root.stacked: CapsLabel {
                        text: @tr("SESSIONS");
                        width: 100px;
                    }
                    CapsLabel {
                        text: @tr("LAST OPENED");
                        width: 150px;
                    }
                    Rectangle {
                        width: 40px;
                    }
                    if !root.stacked: Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                Rule { }
            }
            VerticalLayout {
                padding-bottom: 8px;
                for p[i] in ProjectsUi.rows: Rectangle {
                    height: 60px;
                    background: rta.has-hover ? Theme.hover : (Math.mod(i, 2) == 0 ? Theme.surface : transparent);
                    animate background { duration: Theme.dur-hover; }
                    rta := TouchArea { }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        // Project: dot + name (12 #EDEEF0) + "open" pill, then "parent/name" 11 #6B717C.
                        VerticalLayout {
                            min-width: root.stacked ? 0px : 200px;
                            max-width: root.stacked ? 100000px : 200px;
                            horizontal-stretch: root.stacked ? 1 : 0;
                            alignment: center;
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 7px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Dot {
                                        size: 6px;
                                        tint: root.dots[Math.mod(i, root.dots.length)];
                                    }
                                }
                                Text {
                                    text: p.name;
                                    font-size: 12px;
                                    font-weight: Theme.weight-medium;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if p.current: VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        height: 16px;
                                        text: @tr("open");
                                        tint: Theme.success;
                                    }
                                }
                                if p.unused: VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        height: 16px;
                                        text: @tr("unused");
                                        tint: Theme.muted;
                                    }
                                }
                            }
                            Text {
                                text: p.short;
                                font-size: 11px;
                                color: Theme.icon-subtlest;
                                overflow: elide;
                            }
                        }
                        if !root.stacked: Text {
                            width: 250px;
                            text: p.path;
                            font-size: 11px;
                            color: Theme.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if !root.stacked: Text {
                            width: 100px;
                            text: p.sessions;
                            font-size: 12px;
                            color: Theme.foreground-subtle;
                            vertical-alignment: center;
                        }
                        Text {
                            width: 150px;
                            text: p.last-used;
                            font-size: 11px;
                            color: Theme.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // Remove (design "✕" 11 #6B717C, right of a 40px cell).
                        Rectangle {
                            width: 40px;
                            Rectangle {
                                x: parent.width - self.width + 4px;
                                width: 20px;
                                height: 20px;
                                border-radius: 5px;
                                background: xta.has-hover ? Theme.hover : transparent;
                                accessible-role: button;
                                accessible-label: @tr("Remove {0}", p.name);
                                accessible-enabled: ProjectsUi.available;
                                accessible-action-default => {
                                    ProjectsUi.select-only(p.id);
                                    root.request-remove(false);
                                }
                                Text {
                                    text: "✕";
                                    font-family: "Segoe UI Symbol";
                                    font-size: 11px;
                                    color: xta.has-hover ? Theme.foreground : Theme.icon-subtlest;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                xta := TouchArea {
                                    enabled: ProjectsUi.available;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        ProjectsUi.select-only(p.id);
                                        root.request-remove(false);
                                    }
                                }
                            }
                        }
                        if !root.stacked: Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
                if ProjectsUi.rows.length == 0: EmptyBody {
                    icon: Icons.folders;
                    title: @tr("No projects");
                    hint: @tr("Open a folder in Harness and it shows up here.");
                }
            }
        }
    }
}
