import { Theme } from "../theme/tokens.slint";
import { Icon, Icons } from "../components/controls.slint";
import { PageHeader, StatusLine, SetButton, Pill, Dot, CapsLabel, Switch, SegmentedControl, SearchField } from "parts.slint";

// Checkbox (design "check · on": 16px, radius 4, accent fill + white tick; off = 1px #2A2D33 border).
export component CheckBox inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled();
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: root.checked ? 0px : 1px;
    border-color: Theme.border-hover;
    background: root.checked ? Theme.accent-fg : transparent;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.toggled();
        }
    }
    if root.checked: Icon {
        source: Icons.check;
        size: 11px;
        tint: #ffffff;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }
}

export component Rule inherits Rectangle {
    height: 1px;
    background: Theme.border;
    accessible-role: none;
}

// Card head (design "head": 44px, pad 16, title 13 + sub 11 #6B717C).
export component TableHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> sub;
    height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: Theme.weight-semibold;
            color: Theme.foreground;
        }
        Text {
            text: root.sub;
            font-size: 11px;
            color: Theme.icon-subtlest;
        }
    }
    @children
}
