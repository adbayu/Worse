{
  "name": "worse-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Remote Control relay for Worse Harness (Cloudflare Worker + Durable Object)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "dev": "npm run sync-assets && wrangler dev",
